<Window x:Class="Proyectof.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Piedra, Papel, Tijera, Lagarto, Spock"
        Height="820" Width="567"
        WindowStartupLocation="CenterScreen">

 <!-- Fondo-->
    <Grid>
        <Image Source="Images\fondo.jpg" Stretch="Fill" Opacity="0.6"/>

        <StackPanel Margin="20">

 <!-- titulo-->

            <TextBlock Text="CACHIPÚN"
                       FontFamily="Impact"
                       FontSize="40"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,20"/>
 <!-- Nosotras-->
            <TextBlock Text="by Laryme games"
                       FontFamily="Arial"
                       FontSize="20"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,20"/>

<!-- Videos-->
            <MediaElement x:Name="GifMediaElement"
                          Width="200"
                          Height="200"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Manual"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,15"/>


<!-- BOTON PIEDRA-->
            <Button Width="350" Height="75" Background="#0C82F3" Foreground="White" Click="BtnPiedra_Click" Margin="0,5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0">Piedra</TextBlock>
                    <Image Source="Images\piedra.jpg" Width="60" Height="60" Stretch="Uniform" VerticalAlignment="Center"/>
                </StackPanel>

                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <EventTrigger RoutedEvent="Button.Click">
                            <EventTrigger.Actions>
                            <SoundPlayerAction Source="Sounds\piedra.wav"/>
                            </EventTrigger.Actions>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

 <!-- BOTON PAPEL-->
            <Button Width="350" Height="75" Background="#F94E6A" Foreground="White" Click="BtnPapel_Click" Margin="0,5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0">Papel</TextBlock>
                    <Image Source="Images\papel.jpg" Width="60" Height="60" Stretch="Uniform" VerticalAlignment="Center"/>
                </StackPanel>

                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <EventTrigger RoutedEvent="Button.Click">
                            <EventTrigger.Actions>
                            <SoundPlayerAction Source="Sounds\papel.wav"/>
                            </EventTrigger.Actions>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

<!-- BOTON TIJERA-->
            <Button Width="350" Height="75" Background="#85FF03" Foreground="White" Click="BtnTijera_Click" Margin="0,5">
                <StackPanel 
                    Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0">Tijera</TextBlock>
                    
                    <Image Source="Images\tijeras.jpg" Width="60" Height="60" Stretch="Uniform" VerticalAlignment="Center"/>

                </StackPanel>

                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <EventTrigger RoutedEvent="Button.Click">
                            <EventTrigger.Actions>
                            <SoundPlayerAction Source="Sounds\tijera.wav"/>
                            </EventTrigger.Actions>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

<!-- BOTON LAGARTO-->
            <Button Width="350" Height="75" Background="#FF9F1A" Foreground="White" Click="BtnLagarto_Click" Margin="0,5">
                <StackPanel 
                    
                    Orientation="Horizontal" HorizontalAlignment="Center">
                    
                    <TextBlock FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0">Lagarto</TextBlock>

                    <Image Source="Images\lagarto.jpg" Width="60" Height="60" Stretch="Uniform" VerticalAlignment="Center"/>

                </StackPanel>

                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <EventTrigger RoutedEvent="Button.Click">
                            <EventTrigger.Actions>
                            <SoundPlayerAction Source="Sounds\lagarto.wav"/>
                            </EventTrigger.Actions>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

<!-- BOTON SPOCK -->
            <Button Width="350" Height="75" Background="#9022FF" Foreground="White" Click="BtnSpock_Click" Margin="0,5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                     Margin="0,0,15,0">Spock</TextBlock>

                    <Image Source="Images\spock.webp" Width="60" Height="60" Stretch="Uniform" VerticalAlignment="Center"/>

                </StackPanel>

                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <EventTrigger RoutedEvent="Button.Click">
                            <EventTrigger.Actions>
                            <SoundPlayerAction Source="Sounds\spock.wav"/>
                            </EventTrigger.Actions>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

        </StackPanel>
    </Grid> </Window>