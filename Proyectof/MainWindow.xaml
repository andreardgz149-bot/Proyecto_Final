<Window x:Class="Proyectof.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Piedra, Papel, Tijera, Lagarto, Spock"
Height="670"
Width="567">

<Grid>
        <Image Source="Images\fondo.jpg" Stretch="Fill" Opacity="0.3"/>

<StackPanel Margin="20">

 <!-- TITULO -->     
<TextBlock Text="CACHIPÚN"
FontSize="22"
FontWeight="Bold"
TextWrapping="Wrap"
TextAlignment="Center"
Margin="0,0,0,20"/>

 <!-- Nosotras --> 
<TextBlock Text="by Laryme games"
 FontSize="16"
 TextWrapping="Wrap"
 TextAlignment="Center"
 Margin="0,0,0,20"/>

 <!-- BOTONES -->


 <Button Width="500" Height= "100" Background="#0C82F3" Foreground= "White" Click="BtnPiedra_Click">
    <StackPanel>
        <TextBlock TextAlignment="Center">Piedra </TextBlock>
        <Image Source="Images\piedra.jpg" Width="50" Height="50"/>
    </StackPanel>

    <!--SONIDO-->
    <Button.Style>
    <Style TargetType="Button">
        <Style.Triggers>
            <EventTrigger RoutedEvent= "Button.Click">
                <EventTrigger.Actions>
                    <SoundPlayerAction Source="Sounds\piedra.wav"/>
                        </EventTrigger.Actions>
                            </EventTrigger>
                                </Style.Triggers>
                                    </Style>
                                         </Button.Style>
</Button>

